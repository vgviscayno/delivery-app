{
  "name": "courier-ops",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "fix": "biome check --write .",
    "check:ci": "biome ci .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "db:start": "pnpm --filter @courier/db start",
    "db:reset": "pnpm --filter @courier/db reset",
    "db:seed": "pnpm --filter @courier/db seed",
    "db:types": "pnpm --filter @courier/db types",
    "db:lint:rls": "pnpm --filter @courier/db lint:rls",
    "db:lint:matrix": "pnpm --filter @courier/db lint:matrix",
    "db:lint:schemas": "pnpm --filter @courier/db lint:schemas",
    "db:lint": "pnpm --filter @courier/db lint:gates",
    "db:stop": "pnpm --filter @courier/db stop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
