# Which Supabase the customer app talks to in a dev build. Expo reads this directory's
# .env.local and inlines only EXPO_PUBLIC_* variables. Pilot and production builds get
# theirs from the EAS environment named in eas.json, never from a file.
#
# Local: run `pnpm db:start` and copy the anon key it prints. The Android emulator
# reaches your machine at 10.0.2.2, not 127.0.0.1.

EXPO_PUBLIC_SUPABASE_URL="http://10.0.2.2:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# A Mapbox public token (pk.…). Leave it empty and the app shows no map.
EXPO_PUBLIC_MAPBOX_TOKEN=""
