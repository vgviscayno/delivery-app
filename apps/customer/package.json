{
  "name": "@courier/customer",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "turbo run build --filter=@courier/customer^... && expo start --dev-client",
    "android": "turbo run build --filter=@courier/customer^... && expo run:android",
    "native": "expo prebuild --platform android",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eas-build-post-install": "turbo run build --filter=@courier/customer^..."
  },
  "dependencies": {
    "@courier/api-client": "workspace:*",
    "@courier/config": "workspace:*",
    "@courier/domain": "workspace:*",
    "@rnmapbox/maps": "^10.3.11",
    "expo": "~58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-background-geolocation": "^5.8.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
