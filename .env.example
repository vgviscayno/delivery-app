# Which Supabase the dispatcher console talks to.
#
# Local: run `pnpm db:start` and copy the API URL and anon key it prints.
# Preview and production builds get these injected by CI (.github/workflows/ci.yml).

VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY=""

# Minutes the console may sit untouched before the dispatcher is signed out. Defaults to
# 30. Set it to 1 locally to watch the idle sign-out happen.
# VITE_DISPATCHER_IDLE_MINUTES="30"
